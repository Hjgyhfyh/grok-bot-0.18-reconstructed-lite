# Скопируй в .env и подставь свои значения. .env не коммитится.
# Эти переменные зашиваются в сборку (Vite import.meta.env + build.rs в src-tauri).

# Адрес AI-сервера (OmniRoute, OpenAI-compatible). Для этого ПК: http://127.0.0.1:20128/v1
VITE_AI_BASE_URL=http://127.0.0.1:20128/v1

# Ключ из C:\Users\lesab\.omniroute\.env → OMNIROUTE_API_KEY
VITE_AI_API_KEY=

# Модель через OmniRoute
VITE_AI_MODEL=swe-2-max
