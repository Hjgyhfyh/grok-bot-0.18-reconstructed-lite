# Скопируй в .env и подставь свои значения. Файл .env НЕ коммитится (см. .gitignore).
# Переменные VITE_AI_* зашиваются в сборку: во фронтенд через import.meta.env
# (src/config.ts) и в Rust через build.rs (env!).

# Адрес AI-сервера (OpenAI-compatible, OmniRoute).
# Этот же ПК:    http://127.0.0.1:20128/v1
# Другой ПК LAN: http://<IP-ПК-сервера>:20128/v1
VITE_AI_BASE_URL=http://127.0.0.1:20128/v1

# Ключ доступа. Берётся из C:\Users\<user>\.omniroute\.env → OMNIROUTE_API_KEY.
# ВНИМАНИЕ: ключ зашивается в .exe — любой может извлечь его из файла.
# Не раздавайте собранный установщик публично.
VITE_AI_API_KEY=

# Модель через OmniRoute (короткий алиас; канонический id — devin-desktop/swe-2-max)
VITE_AI_MODEL=swe-2-max
